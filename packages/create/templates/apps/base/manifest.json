{
  "id": "app-base",
  "kind": "app",
  "type": "base",
  "version": "1.0.0",
  "displayName": "App Base",
  "description": "Shared Stratix application baseline",
  "runtime": "web",
  "contributes": {
    "directories": [
      "src/config",
      "src/controllers",
      "src/services",
      "src/repositories",
      "src/repositories/interfaces",
      "src/components",
      "src/types"
    ],
    "dependencies": {
      "runtime": {
        "@stratix/core": "^1.1.0"
      },
      "dev": {
        "@stratix/forge": "^1.1.4",
        "@tsconfig/recommended": "^1.0.13",
        "@types/node": "^25.9.3",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "tsx": "^4.22.4",
        "typescript": "^7.0.2"
      }
    },
    "scripts": {
      "clean": "rimraf dist",
      "build": "rimraf dist && tsc",
      "start": "node dist/index.js",
      "dev": "tsx --watch src/index.ts",
      "lint": "oxlint --type-aware .",
      "security:audit": "pnpm audit --prod --audit-level high",
      "env": "stratix config encrypt prod.env.json",
      "env:dev": "stratix config encrypt dev.env.json",
      "env:decrypt": "stratix config decrypt"
    },
    "env": [],
    "policies": {
      "layering": ["controller", "service", "repository"],
      "forbidServiceDatabasePlugin": true,
      "forbidControllerDatabaseAccess": true,
      "controllerDecoratorPrefix": false,
      "pluginTokenFromFunctionName": true
    }
  }
}
